{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*.ts", "src/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
