{
  "name": "@flighthq/compiler-command-line",
  "version": "0.0.0",
  "description": "Pointing the compiler at a directory of TypeScript",
  "author": "Joshua Granick and other contributors",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/flighthq/flight-compiler.git",
    "directory": "packages/compiler-command-line"
  },
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "@flighthq/compiler-backend-cpp": "*",
    "@flighthq/compiler-backend-hx": "*",
    "@flighthq/compiler-backend-rs": "*",
    "@flighthq/compiler-canonical-form": "*",
    "@flighthq/compiler-emission": "*",
    "@flighthq/compiler-orchestration": "*",
    "@flighthq/compiler-types": "*"
  },
  "scripts": {
    "test": "vitest run --config ../../vitest.config.package.ts --root .",
    "test:watch": "vitest --config ../../vitest.config.package.ts --root .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
